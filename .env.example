# Sao chép file này thành .env rồi sửa giá trị. KHÔNG commit file .env.
SECRET_KEY=doi-gia-tri-nay

# ---- Chạy trực tiếp trên máy (không dùng Docker) ----
# Ví dụ MySQL: mysql+pymysql://user:password@localhost:3306/attendance?charset=utf8mb4
DATABASE_URL=sqlite:///attendance.sqlite3
FLASK_DEBUG=1

# ---- Docker Compose (docker compose up --build) ----
# Docker tự ghép DATABASE_URL trỏ tới dịch vụ MySQL nên DATABASE_URL ở trên không được dùng.
# Mật khẩu chỉ nên gồm chữ và số (ký tự đặc biệt làm hỏng chuỗi kết nối).
MYSQL_DATABASE=attendance
MYSQL_USER=attendance
MYSQL_PASSWORD=attendance_pw
MYSQL_ROOT_PASSWORD=root_pw
WEB_PORT=5000
# 1 = nạp dữ liệu mẫu mỗi lần khởi động (an toàn chạy lại); 0 = không nạp
SEED_ON_START=1
